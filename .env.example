# ---- Docker Compose 统一配置 ----
# 复制为 .env 后由 docker compose 读取；应用环境变量由 compose environment 注入。
# 发布版：All-in-One 服务名 ecohub；源码版：server / web 分服务。
# 本地直接 go run 时请改用 server/.env（见 server/.env.example）。

# 对外端口（映射到宿主机）。如需不对公网暴露裸端口，可在 compose.yml 中绑定 127.0.0.1 配合反向代理。
# MySQL / Redis 默认仅在容器网络内互联，不映射外部端口。
WEB_PORT=3000          # Web 前台与后台端口
SERVER_PORT=18080      # API 直连端口（可选，供 TVBox/播放器）

# ---- 业务配置（必填）----
JWT_SECRET='ecohub_2026!local@dev_secret$001'
# 初始超级管理员密码（首次数据库初始化生效；未配置默认 admin，对外部署建议改为强密码）
ECOHUB_ADMIN_PASSWORD=admin
# ---- MySQL（必填）----
MYSQL_ROOT_PASSWORD=ecohub
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=eco
MYSQL_PASSWORD=ecohub
MYSQL_DBNAME=eco

# ---- Redis（必填）----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ecohub
REDIS_DB=0

# ---- 采集（可选；默认 auto 按服务器 CPU 核数自动选档）----
# 档位：light≤2核 / standard 3-7核 / high≥8核；写阀与并发无需手动调整。
# COLLECT_PROFILE=auto   # auto|light|standard|high

# ---- 数据分析（可选；默认关闭）----
# 开启全站访问量、播放热度与客户端设备统计（默认 false，按需开启以保持最低系统开销）
# ACCESS_ANALYTICS_ENABLED=false
