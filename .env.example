# ---- Docker Compose 统一配置 ----

# 对外端口号，容器内部端口保持默认值。
# MySQL / Redis 默认不对宿主机暴露端口。
WEB_PUBLIC_PORT=3000
SERVER_PUBLIC_PORT=18080

# Server
SERVER_PORT=8080
JWT_SECRET='ecohub_2026!local@dev_secret$001'

# 采集写阀（可选，覆盖服务端默认；单位见注释）
# COLLECT_WRITE_MAX_INFLIGHT=2          # 同时写库事务数
# COLLECT_WRITE_PAGES_PER_SEC=12        # 稳态页/秒
# COLLECT_WRITE_BURST_PAGES=2           # 小突发
# COLLECT_WRITE_PENDING_PER_SOURCE=50   # 单站写队列上限
# COLLECT_WRITE_PENDING_GLOBAL=150      # 全局写队列上限
# COLLECT_STATS_FLUSH_INTERVAL_SEC=5    # last_collect_time 合并间隔
# COLLECT_CACHE_FLUSH_INTERVAL_SEC=5    # 缓存清理合并间隔
# COLLECT_PROGRESS_RETAIN_SEC=60        # done/failed 展示保留
# COLLECT_PROGRESS_STALE_SEC=1800       # 活跃进度超时（秒）

# MySQL
MYSQL_ROOT_PASSWORD=ecohub
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=eco
MYSQL_PASSWORD=ecohub
MYSQL_DBNAME=eco

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ecohub
REDIS_DB=0
