# ---- Docker Compose 统一配置 ----
# 复制为 .env 后由 docker compose 读取；server 容器通过 compose environment 注入。
# 本地直接 go run 时请改用 server/.env（见 server/.env.example）。

# 对外端口（映射到宿主机）。MySQL / Redis 发布版默认不映射端口。
WEB_PUBLIC_PORT=3000
SERVER_PUBLIC_PORT=18080

# ---- Server（必填）----
# 容器内监听端口；compose 会映射为环境变量 PORT
SERVER_PORT=8080
JWT_SECRET='ecohub_2026!local@dev_secret$001'

# ---- MySQL（必填）----
MYSQL_ROOT_PASSWORD=ecohub
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=eco
MYSQL_PASSWORD=ecohub
MYSQL_DBNAME=eco

# ---- Redis（必填）----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ecohub
REDIS_DB=0

# ---- Telegram 通知（可选）----
# Bot Token / Chat ID 在管理后台配置；此处仅代理等进程环境变量。
# 国内直连 api.telegram.org 常超时，需走代理（Clash/V2Ray 等）。
# 优先级：TELEGRAM_PROXY > HTTPS_PROXY / HTTP_PROXY / ALL_PROXY
# 协议：http:// 与 socks5://
# Docker 内访问宿主机代理请用 host.docker.internal（源码版 compose 已配 extra_hosts）
# TELEGRAM_PROXY=http://host.docker.internal:7890
# TELEGRAM_PROXY=socks5://host.docker.internal:7891
# HTTPS_PROXY=http://host.docker.internal:7890
# HTTP_PROXY=http://host.docker.internal:7890
# ALL_PROXY=socks5://host.docker.internal:7891

# ---- 采集写阀（可选，未设置则用服务端默认）----
# COLLECT_WRITE_MAX_INFLIGHT=2          # 同时写库事务数
# COLLECT_WRITE_PAGES_PER_SEC=12        # 稳态页/秒
# COLLECT_WRITE_BURST_PAGES=2           # 小突发
# COLLECT_WRITE_PENDING_PER_SOURCE=50   # 单站写队列上限
# COLLECT_WRITE_PENDING_GLOBAL=150      # 全局写队列上限
# COLLECT_STATS_FLUSH_INTERVAL_SEC=5    # last_collect_time 合并间隔（秒）
# COLLECT_CACHE_FLUSH_INTERVAL_SEC=5    # 缓存清理合并间隔（秒）
# COLLECT_PROGRESS_RETAIN_SEC=60        # done/failed 展示保留（秒）
# COLLECT_PROGRESS_STALE_SEC=1800       # 活跃进度超时（秒）
