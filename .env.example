# ---- Docker Compose 统一配置 ----
# 复制为 .env 后由 docker compose 读取；应用环境变量由 compose environment 注入。
# 发布版：All-in-One 服务名 ecohub；源码版：server / web 分服务。
# 本地直接 go run 时请改用 server/.env（见 server/.env.example）。

# 对外端口（映射到宿主机）。MySQL / Redis 发布版默认不映射端口。
WEB_PUBLIC_PORT=3000
SERVER_PUBLIC_PORT=18080

# ---- Server（必填）----
# 容器内监听端口；compose 会映射为环境变量 PORT
SERVER_PORT=8080
JWT_SECRET='ecohub_2026!local@dev_secret$001'

# ---- MySQL（必填）----
MYSQL_ROOT_PASSWORD=ecohub
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=eco
MYSQL_PASSWORD=ecohub
MYSQL_DBNAME=eco

# ---- Redis（必填）----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ecohub
REDIS_DB=0

# ---- Telegram 通知（可选）----
# Bot Token / Chat ID 在管理后台配置；此处仅代理等进程环境变量。
# 国内直连 api.telegram.org 常超时，需走代理（Clash/V2Ray 等）。
# 仅需 TG_PROXY（优先级高于通用代理；协议 http:// 或 socks5://）
# Docker 内访问宿主机代理请用 host.docker.internal（源码版 compose 已配 extra_hosts）
# TG_PROXY=http://host.docker.internal:7890
# TG_PROXY=socks5://host.docker.internal:7891

# ---- 采集（可选；默认 auto 按服务器 CPU 核数自动选档）----
# 档位：light≤2核 / standard 3-7核 / high≥8核；写阀与并发无需手动调整。
# COLLECT_PROFILE=auto   # auto|light|standard|high
