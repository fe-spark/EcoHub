# ---- 本地 go run / 直接跑 server 二进制 ----
# Docker 部署请用仓库根目录 .env.example（变量名 SERVER_PORT 等由 compose 映射）。

# ---- 服务端口（必填）----
PORT=8080

# ---- JWT（必填）----
JWT_SECRET=ecohub_2026!local@dev_secret$001

# ---- MySQL（必填）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=eco
MYSQL_PASSWORD=ecohub
MYSQL_DBNAME=eco

# ---- Redis（必填）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=ecohub
REDIS_DB=0

# ---- Telegram 通知（可选）----
# Bot Token / Chat ID 在管理后台配置；此处仅代理等进程环境变量。
# 国内直连 api.telegram.org 常超时，需走本地代理（Clash/V2Ray 等）
# 优先级：TELEGRAM_PROXY > HTTPS_PROXY / HTTP_PROXY / ALL_PROXY
# 协议：http:// 与 socks5://
# TELEGRAM_PROXY=http://127.0.0.1:7890
# TELEGRAM_PROXY=socks5://127.0.0.1:7891
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7891

# ---- 采集写阀（可选，未设置则用服务端默认）----
# COLLECT_WRITE_MAX_INFLIGHT=2
# COLLECT_WRITE_PAGES_PER_SEC=12
# COLLECT_WRITE_BURST_PAGES=2
# COLLECT_WRITE_PENDING_PER_SOURCE=50
# COLLECT_WRITE_PENDING_GLOBAL=150
# COLLECT_STATS_FLUSH_INTERVAL_SEC=5
# COLLECT_CACHE_FLUSH_INTERVAL_SEC=5
# COLLECT_PROGRESS_RETAIN_SEC=60
# COLLECT_PROGRESS_STALE_SEC=1800
