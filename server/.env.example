# ---- 本地 go run / 直接跑 server 二进制 ----
# Docker 部署请用仓库根目录 .env.example（变量名 SERVER_PORT 等由 compose 映射）。

# ---- 服务端口（必填）----
PORT=8080

# ---- JWT（必填）----
JWT_SECRET=ecohub_2026!local@dev_secret$001
# 初始超级管理员密码（首次数据库初始化生效；未配置默认 admin）
ECOHUB_ADMIN_PASSWORD=admin
# ---- MySQL（必填）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=eco
MYSQL_PASSWORD=ecohub
MYSQL_DBNAME=eco

# ---- Redis（必填）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=ecohub
REDIS_DB=0

# ---- 数据分析（可选；默认关闭）----
# 开启全站访问量、播放热度与客户端设备统计（默认 false，按需开启以保持最低系统开销）
# ACCESS_ANALYTICS_ENABLED=false
