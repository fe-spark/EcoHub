# ---- 本地 go run / 直接跑 server 二进制 ----
# Docker 部署请用仓库根目录 .env.example（变量名 SERVER_PORT 等由 compose 映射）。

# ---- 服务端口（必填）----
PORT=8080

# ---- JWT（必填）----
JWT_SECRET=ecohub_2026!local@dev_secret$001

# ---- MySQL（必填）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=eco
MYSQL_PASSWORD=ecohub
MYSQL_DBNAME=eco

# ---- Redis（必填）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=ecohub
REDIS_DB=0

# ---- Telegram 通知（可选）----
# Bot Token / Chat ID 在管理后台配置；此处仅代理等进程环境变量。
# 国内直连 api.telegram.org 常超时，需走本地代理（Clash/V2Ray 等）
# 仅需 TG_PROXY（优先级高于通用代理；协议 http:// 或 socks5://）
# TG_PROXY=http://127.0.0.1:7890
# TG_PROXY=socks5://127.0.0.1:7891

# ---- 采集（可选；默认 auto 按服务器 CPU 核数自动选档）----
# 档位：light≤2核 / standard 3-7核 / high≥8核；写阀与并发无需手动调整。
# COLLECT_PROFILE=auto   # auto|light|standard|high
